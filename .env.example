# ==============================================================================
# peopleFirst Environment Configuration Example
# Copy this file to .env and set your custom values
# ==============================================================================

# Generative AI (Google Gemini / OpenAI) Configuration
# Models: gemini-1.5-pro (default medium-range), gpt-3.5-turbo, gpt-4o-mini
GEMINI_API_KEY=
OPENAI_API_KEY=
GENAI_MODEL=gemini-1.5-pro
GENAI_ENABLED=true

# OpenAI-compatible endpoint (OpenRouter, LiteLLM, Azure, Ollama/vLLM, or OpenAI itself).
# Leave the default until you have a real URL — without a reachable endpoint Kura runs rule-based.
OPENAI_BASE_URL=https://api.openai.com/v1
# Provider routing: auto | openai_compatible | gemini
GENAI_PROVIDER=auto

# Active Spring Profile (dev = in-memory H2, postgres = external PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# JWT Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# PostgreSQL Settings (used when SPRING_PROFILES_ACTIVE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peoplefirst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
